%% Arquitectura del sistema · Proyecto MiBici · TC5061 Equipo 10
%% Fuente de la Figura 2 de la Entrega 01. Se exporta a arquitectura.png con mermaid-cli (ver docs/entregas/entrega01/README.md).
%% Colores: azul = versionado en Git · naranja = almacenamiento local fuera de Git · verde punteado = servidor en Azure planeado.
flowchart TB

  CSV["<b>1 · Fuente de datos</b><br/>24 CSV mensuales de viajes<br/>enlaces descubiertos en la<br/>página datos-abiertos de MiBici"]
  NOM["<b>1 · Fuente de datos</b><br/>Catálogo de estaciones<br/>nomenclatura_2026_09.csv"]
  CFG["<b>2 · Configuración (Git)</b><br/>mibici/config.py<br/>rango de fechas · cortes de la partición · semilla<br/>contrato de datos · reglas de limpieza · parámetros de P2 y P3"]
  MAN["<b>2 · Versión de datos (Git)</b><br/>datapackage.json · Frictionless Data Package<br/>version · un recurso por CSV y Parquet: URL · bytes · SHA-256 · codificación · esquema<br/>(lo escribe make snapshot; cada cambio entra por PR)"]
  SNAP["<b>2 · Instantánea · make snapshot</b><br/>mibici/datapackage.py<br/>descubre enlaces · descarga · describe con frictionless<br/>limpia · escribe el descriptor · valida"]

  INGEST["<b>3 · Ingesta · make data</b><br/>mibici/dataset.py<br/>descarga las URL del descriptor · verifica bytes y SHA-256 antes de procesar<br/>valida el esquema con frictionless · normaliza columnas y fechas<br/>limpia viajes · descarta datos personales · comprueba los Parquet"]

  RAW[("<b>4 · Almacenamiento local</b><br/>data/raw<br/>CSV originales, tal como se descargan")]
  PROC[("<b>4 · Almacenamiento local</b><br/>data/processed<br/>meses.parquet · nomenclatura.parquet")]

  FEAT["<b>5 · Procesamiento (en memoria)</b><br/>mibici/features.py<br/>load_data valida el contrato · split_by_date<br/>tablas P1 (estación-hora) · P2 (estación-intervalo) · P3 (perfil)"]

  TRAIN["<b>6 · Entrenamiento · make train</b><br/>mibici/modeling/train.py + baselines.py<br/>GroupedDummy (P1, P2) · StandardScaler + KMeans (P3)<br/>partición cronológica · métricas por conjunto · figuras (plots.py)"]
  MODELS[("<b>4 · Almacenamiento local</b><br/>models/*.joblib")]

  CLIENT["<b>7 · Registro de experimentos</b><br/>cliente MLflow en train.py · experimento mibici-equipo10<br/>params · métricas · etiquetas · artefactos<br/>backend elegido con MLFLOW_TRACKING_URI (.env)"]
  LOCAL[("<b>7 · Backend local</b><br/>mlflow.db (SQLite) + mlartifacts/<br/>mlflow ui")]
  AZURE[("<b>7 · Backend en Azure (planeado)</b><br/>servidor MLflow en Container Apps<br/>PostgreSQL + Blob Storage")]

  CSV --> SNAP
  NOM --> SNAP
  CFG --> SNAP
  SNAP --> MAN
  MAN -- "URL · bytes · hash · esquema" --> INGEST
  CSV -. "descarga lo que falte" .-> INGEST
  NOM -. "descarga lo que falte" .-> INGEST
  CFG --> INGEST
  INGEST --> RAW
  INGEST --> PROC
  PROC --> FEAT --> TRAIN
  CFG --> TRAIN
  MAN -. "param version_datos · dataset input · artefacto" .-> TRAIN
  TRAIN --> MODELS
  TRAIN --> CLIENT
  CLIENT --> LOCAL
  CLIENT -.-> AZURE

  classDef git fill:#e8f1fb,stroke:#2b6cb0,stroke-width:1.5px,color:#1a365d
  classDef local fill:#fff7e6,stroke:#b7791f,stroke-width:1.5px,color:#5f370e
  classDef cloud fill:#e6fffa,stroke:#2c7a7b,stroke-width:1.5px,color:#234e52,stroke-dasharray:6 4
  class CFG,MAN git
  class RAW,PROC,MODELS,LOCAL local
  class AZURE cloud
