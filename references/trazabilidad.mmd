%% Cadena de trazabilidad de un run · Proyecto MiBici · TC5061 Equipo 10
%% Fuente de la Figura 3 de la Entrega 01. Se exporta a trazabilidad.png con mermaid-cli.
%% Colores: azul = en Git · naranja = regenerado en cada máquina · verde = registro en MLflow.
flowchart TB

  MAN["<b>Descriptor de datos (Git)</b><br/>datapackage.json · version 2026-10<br/>URL · bytes · SHA-256 · esquema de cada CSV y Parquet<br/>(lo escribe make snapshot)"]
  COMMIT["<b>Commit del código (Git)</b><br/>mibici/ · config.py"]
  REQ["<b>Entorno (Git)</b><br/>requirements.txt con versiones fijas"]

  DATA[("<b>Datos regenerados</b><br/>data/raw verificado contra el descriptor antes de procesar<br/>data/processed · meses.parquet · nomenclatura.parquet")]
  CHECK["<b>Contrato de datos</b><br/>load_data valida columnas y tipos<br/>get_data_version lee la versión del descriptor"]

  RUN["<b>Run de MLflow</b><br/>params: version_datos · fechas de la partición · semilla · modelo · hiperparámetros<br/>tags: equipo · pregunta · git_commit · tipo_modelo<br/>métricas: test_mae · test_rmse · test_recall_vaciarse · test_f1_macro · train_silhouette · …<br/>dataset input: datapackage, digest = version · artefactos: figuras · modelo · tablas de grupos · datapackage.json"]

  MAN -- "make data descarga, verifica bytes y hash y limpia" --> DATA
  COMMIT -- "reglas de limpieza" --> DATA
  REQ ~~~ DATA
  DATA --> CHECK
  CHECK -- "train.py entrena y registra" --> RUN
  MAN -. "param version_datos · dataset input" .-> RUN
  COMMIT -. "tag git_commit" .-> RUN
  REQ -. "mismo entorno" .-> RUN

  classDef git fill:#e8f1fb,stroke:#2b6cb0,stroke-width:1.5px,color:#1a365d
  classDef local fill:#fff7e6,stroke:#b7791f,stroke-width:1.5px,color:#5f370e
  classDef run fill:#f0fff4,stroke:#2f855a,stroke-width:1.5px,color:#22543d
  class MAN,COMMIT,REQ git
  class DATA,CHECK local
  class RUN run
