%% Cadena de trazabilidad de un run · Proyecto MiBici · TC5061 Equipo 10
%% Fuente de la Figura 3 de la Entrega 01. Se exporta a trazabilidad.png con mermaid-cli.
%% Colores: azul = en Git · naranja = regenerado en cada máquina · verde = registro en MLflow.
flowchart TB

  MAN["<b>Descriptor de datos (Git)</b><br/>mibici/datapackage.json · version 2026-10"]
  COMMIT["<b>Commit del código (Git)</b><br/>mibici/ · config.py"]
  REQ["<b>Entorno (Git)</b><br/>requirements.txt con versiones fijas"]

  DATA[("<b>Datos regenerados</b><br/>data/processed · tablas P1 · P2 · P3")]
  RECEIPT["<b>Recibo de construcción</b><br/>data_version · commit · filas · esquema"]

  RUN["<b>Run de MLflow</b><br/>params: data_version · start_date · end_date · fechas de corte · random_seed · hiperparámetros<br/>tags: team · question · git_commit<br/>métricas: test_mae · test_rmse · test_recall · test_f1 · …<br/>artefactos: figuras · modelo · descriptor<br/>dataset (log_input): nombre · digest · fuente"]

  MAN -- "make data verifica los hashes" --> DATA
  COMMIT -- "make data · make features" --> DATA
  REQ ~~~ DATA
  DATA --> RECEIPT
  RECEIPT -- "train.py comprueba antes de entrenar" --> RUN
  MAN -. "param data_version" .-> RUN
  COMMIT -. "tag git_commit" .-> RUN
  REQ -. "mismo entorno" .-> RUN

  classDef git fill:#e8f1fb,stroke:#2b6cb0,stroke-width:1.5px,color:#1a365d
  classDef local fill:#fff7e6,stroke:#b7791f,stroke-width:1.5px,color:#5f370e
  classDef run fill:#f0fff4,stroke:#2f855a,stroke-width:1.5px,color:#22543d
  class MAN,COMMIT,REQ git
  class DATA,RECEIPT local
  class RUN run
