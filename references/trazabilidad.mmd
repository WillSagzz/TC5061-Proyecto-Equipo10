%% Cadena de trazabilidad de un run · Proyecto MiBici · TC5061 Equipo 10
%% Fuente de la Figura 3 de la Entrega 01. Se exporta a trazabilidad.png con mermaid-cli.
%% Colores: azul = en Git · naranja = regenerado en cada máquina · verde = registro en MLflow.
flowchart TB

  MAN["<b>Manifiesto de datos (Git)</b><br/>data_manifest.json · version 1c3d603c990c<br/>SHA-256 de cada CSV y Parquet"]
  COMMIT["<b>Commit del código (Git)</b><br/>mibici/ · config.py"]
  REQ["<b>Entorno (Git)</b><br/>requirements.txt con versiones fijas"]

  DATA[("<b>Datos regenerados</b><br/>data/processed · meses.parquet · nomenclatura.parquet")]
  CHECK["<b>Contrato de datos</b><br/>load_data valida columnas y tipos<br/>get_data_version lee el manifiesto"]

  RUN["<b>Run de MLflow</b><br/>params: version_datos · fechas de la partición · semilla · modelo · hiperparámetros<br/>tags: equipo · pregunta · git_commit · tipo_modelo<br/>métricas: test_mae · test_rmse · test_recall_vaciarse · test_f1_macro · train_silhouette · …<br/>artefactos: figuras · modelo · tablas de grupos"]

  COMMIT -- "make data escribe los Parquet y el manifiesto" --> DATA
  DATA -. "hashes" .-> MAN
  REQ ~~~ DATA
  DATA --> CHECK
  CHECK -- "train.py entrena y registra" --> RUN
  MAN -. "param version_datos" .-> RUN
  COMMIT -. "tag git_commit" .-> RUN
  REQ -. "mismo entorno" .-> RUN

  classDef git fill:#e8f1fb,stroke:#2b6cb0,stroke-width:1.5px,color:#1a365d
  classDef local fill:#fff7e6,stroke:#b7791f,stroke-width:1.5px,color:#5f370e
  classDef run fill:#f0fff4,stroke:#2f855a,stroke-width:1.5px,color:#22543d
  class MAN,COMMIT,REQ git
  class DATA,CHECK local
  class RUN run
