name: mibici-equipo10

python_env: python_env.yaml

entry_points:
  ingest:
    command: "python -m mibici.dataset"

  # `model` es un estimador del catálogo de train.py (baseline, rf, hgb, kmeans); un
  # hiperparámetro vacío toma el valor por defecto. MLflow entrecomilla cada valor, por eso
  # el comando no los cita.
  train:
    parameters:
      question: string
      model: {type: string, default: baseline}
      n_estimators: {type: string, default: ""}
      max_iter: {type: string, default: ""}
      max_depth: {type: string, default: ""}
      learning_rate: {type: string, default: ""}
      n_clusters: {type: string, default: ""}
    command: >-
      python -m mibici.modeling.train {question}
      --model {model}
      --n-estimators {n_estimators}
      --max-iter {max_iter}
      --max-depth {max_depth}
      --learning-rate {learning_rate}
      --n-clusters {n_clusters}
